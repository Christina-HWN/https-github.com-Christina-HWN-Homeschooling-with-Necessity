<svg id="emblemSvg" viewBox="0 0 1000 1000" class="w-full h-full drop-shadow-2xl selection:bg-none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <!-- Radial Background Gradient -->
                        <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
                            <stop offset="0%" stop-color="#3bb3be"/>
                            <stop offset="60%" stop-color="#0f515c"/>
                            <stop offset="100%" stop-color="#002934"/>
                        </radialGradient>

                        <!-- Metallic Silver Frame Gradient -->
                        <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#ffffff"/>
                            <stop offset="25%" stop-color="#d1e3e7"/>
                            <stop offset="50%" stop-color="#8faab2"/>
                            <stop offset="75%" stop-color="#eaf3f5"/>
                            <stop offset="100%" stop-color="#69858e"/>
                        </linearGradient>

                        <!-- Gold Frame Preset Gradient -->
                        <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#fff6d1"/>
                            <stop offset="30%" stop-color="#f5d061"/>
                            <stop offset="60%" stop-color="#9e721d"/>
                            <stop offset="85%" stop-color="#fce28b"/>
                            <stop offset="100%" stop-color="#6e4c0e"/>
                        </linearGradient>

                        <!-- House Roof Gradient -->
                        <linearGradient id="roofGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#3eb8c4"/>
                            <stop offset="100%" stop-color="#195a62"/>
                        </linearGradient>

                        <!-- Open Book Paper Gradient -->
                        <linearGradient id="paperGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#f3ebd9"/>
                            <stop offset="48%" stop-color="#fffbf2"/>
                            <stop offset="50%" stop-color="#ded0b6"/>
                            <stop offset="52%" stop-color="#fffbf2"/>
                            <stop offset="100%" stop-color="#f3ebd9"/>
                        </linearGradient>

                        <!-- Inkwell Glass Gradient -->
                        <radialGradient id="inkwellGrad" cx="35%" cy="35%" r="65%">
                            <stop offset="0%" stop-color="#72dae5"/>
                            <stop offset="40%" stop-color="#1d7b87"/>
                            <stop offset="85%" stop-color="#09383f"/>
                            <stop offset="100%" stop-color="#031a1e"/>
                        </radialGradient>

                        <!-- Banner Ribbon Gradient -->
                        <linearGradient id="bannerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#124049"/>
                            <stop offset="100%" stop-color="#00222b"/>
                        </linearGradient>

                        <!-- Drop Shadows -->
                        <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
                            <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.4"/>
                        </filter>
                        
                        <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
                            <feGaussianBlur stdDeviation="4" result="blur"/>
                            <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                        </filter>

                        <!-- Pattern for corner watermarks -->
                        <g id="miniBookWatermark">
                            <path d="M-20,0 Q-10,-10 0,-3 Q10,-10 20,0 L20,25 Q10,15 0,20 Q-10,15 -20,25 Z" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.15"/>
                        </g>
                    </defs>

                    <!-- Outer Background Tile -->
                    <rect width="1000" height="1000" fill="url(#bgGrad)" rx="24"/>

                    <!-- Background Corner Watermark Books -->
                    <g id="cornerBooksGroup" stroke="#ffffff" fill="none" opacity="0.12" style="display: block;">
                        <!-- Top Left Open Book -->
                        <g transform="translate(140, 140) rotate(-25) scale(2)">
                            <path d="M-40,0 Q-20,-20 0,-5 Q20,-20 40,0 L35,45 Q20,28 0,33 Q-20,28 -35,45 Z" stroke-width="2"/>
                            <path d="M0,-5 L0,33" stroke-width="1.5"/>
                            <path d="M-30,10 Q-15,-5 -5,5 M-30,20 Q-15,5 -5,15 M-30,30 Q-15,15 -5,25" stroke-width="1"/>
                            <path d="M30,10 Q15,-5 5,5 M30,20 Q15,5 5,15 M30,30 Q15,15 5,25" stroke-width="1"/>
                        </g>
                        <!-- Top Right Open Book -->
                        <g transform="translate(860, 140) rotate(25) scale(2)">
                            <path d="M-40,0 Q-20,-20 0,-5 Q20,-20 40,0 L35,45 Q20,28 0,33 Q-20,28 -35,45 Z" stroke-width="2"/>
                            <path d="M0,-5 L0,33" stroke-width="1.5"/>
                            <path d="M-30,10 Q-15,-5 -5,5 M-30,20 Q-15,5 -5,15 M-30,30 Q-15,15 -5,25" stroke-width="1"/>
                            <path d="M30,10 Q15,-5 5,5 M30,20 Q15,5 5,15 M30,30 Q15,15 5,25" stroke-width="1"/>
                        </g>
                        <!-- Bottom Left Open Book -->
                        <g transform="translate(120, 860) rotate(15) scale(1.8)">
                            <path d="M-40,0 Q-20,-20 0,-5 Q20,-20 40,0 L35,45 Q20,28 0,33 Q-20,28 -35,45 Z" stroke-width="2"/>
                        </g>
                        <!-- Bottom Right Open Book -->
                        <g transform="translate(880, 860) rotate(-15) scale(1.8)">
                            <path d="M-40,0 Q-20,-20 0,-5 Q20,-20 40,0 L35,45 Q20,28 0,33 Q-20,28 -35,45 Z" stroke-width="2"/>
                        </g>
                    </g>

                    <!-- Stars & Moon accents outside emblem -->
                    <g id="starsGroup" fill="url(#silverGrad)" opacity="0.7" style="display: block;">
                        <path transform="translate(500, 75) scale(0.8)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        <path transform="translate(230, 260) scale(0.6)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        <path transform="translate(770, 260) scale(0.6)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        <path transform="translate(180, 500) scale(0.5)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        <path transform="translate(820, 500) scale(0.5)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        <path transform="translate(260, 740) scale(0.6)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        <path transform="translate(740, 740) scale(0.6)" d="M0,-15 L4,-4 L15,0 L4,4 L0,15 L-4,4 L-15,0 L-4,-4 Z"/>
                        
                        <!-- Crescent Moons -->
                        <path transform="translate(240, 360) rotate(-20) scale(0.8)" d="M0,-15 A15,15 0 1,0 15,10 A12,12 0 1,1 0,-15 Z"/>
                        <path transform="translate(760, 360) rotate(20) scale(0.8)" d="M0,-15 A15,15 0 1,0 15,10 A12,12 0 1,1 0,-15 Z"/>
                    </g>

                    <!-- Main Circular Outer Frame -->
                    <g id="mainFrame" filter="url(#dropShadow)">
                        <!-- Outer Silver Ring -->
                        <circle cx="500" cy="460" r="410" fill="none" stroke="url(#silverGrad)" stroke-width="12"/>
                        <!-- Inner Filigree Ring Base -->
                        <circle cx="500" cy="460" r="390" fill="#0d3c43" stroke="url(#silverGrad)" stroke-width="4"/>
                        <circle cx="500" cy="460" r="365" fill="none" stroke="url(#silverGrad)" stroke-width="3" stroke-dasharray="6,6"/>
                        <circle cx="500" cy="460" r="350" fill="#124952" stroke="url(#silverGrad)" stroke-width="4"/>

                        <!-- Heart Crest at top of frame -->
                        <path transform="translate(500, 108) scale(1.3)" d="M0,-5 C-10,-20 -25,-5 0,15 C25,-5 10,-20 0,-5 Z" fill="url(#silverGrad)" stroke="#09292f" stroke-width="1 font-playfair"/>

                        <!-- Filigree Scrolling Patterns around frame -->
                        <g stroke="url(#silverGrad)" fill="none" stroke-width="3.5" stroke-linecap="round">
                            <!-- Left Arc Scrollwork -->
                            <path d="M 170,420 C 140,350 150,280 210,220 C 240,190 280,160 340,140"/>
                            <path d="M 185,410 C 165,340 180,290 220,240"/>
                            <!-- Right Arc Scrollwork -->
                            <path d="M 830,420 C 860,350 850,280 790,220 C 760,190 720,160 660,140"/>
                            <path d="M 815,410 C 835,340 820,290 780,240"/>
                        </g>
                    </g>

                    <!-- House in Background -->
                    <g id="houseGroup" transform="translate(500, 310)" filter="url(#dropShadow)" style="display: block;">
                        <!-- Main House Body -->
                        <rect x="-180" y="-30" width="360" height="200" fill="#75c2cb" stroke="#0e3338" stroke-width="5" rx="4"/>
                        <!-- Side Wing Extensions -->
                        <rect x="-220" y="20" width="440" height="150" fill="#5db2bd" stroke="#0e3338" stroke-width="5" rx="3"/>
                        
                        <!-- Roof Tiles Gable -->
                        <path d="M-210,-30 L0,-180 L210,-30 Z" fill="url(#roofGrad)" stroke="#0e3338" stroke-width="6"/>
                        <!-- Outer Roof Trim -->
                        <path d="M-225,-25 L0,-195 L225,-25" fill="none" stroke="url(#silverGrad)" stroke-width="8" stroke-linecap="round"/>
                        
                        <!-- Chimney -->
                        <rect x="100" y="-150" width="45" height="70" fill="#3eb8c4" stroke="#0e3338" stroke-width="4"/>
                        <rect x="92" y="-160" width="61" height="15" fill="url(#silverGrad)" stroke="#0e3338" stroke-width="3" rx="2"/>
                        <!-- Smoke Wisps -->
                        <path d="M120,-170 Q110,-200 130,-220 T120,-250" fill="none" stroke="url(#silverGrad)" stroke-width="3" opacity="0.6" stroke-linecap="round"/>

                        <!-- Center Attic Window -->
                        <path d="M-35,-100 A35,35 0 0,1 35,-100 L35,-50 L-35,-50 Z" fill="#eaf7f9" stroke="#0e3338" stroke-width="4"/>
                        <line x1="0" y1="-135" x2="0" y2="-50" stroke="#0e3338" stroke-width="3"/>
                        <line x1="-35" y1="-85" x2="35" y2="-85" stroke="#0e3338" stroke-width="3"/>

                        <!-- Ground Windows & Front Door -->
                        <rect x="-150" y="30" width="55" height="65" fill="#eaf7f9" stroke="#0e3338" stroke-width="4" rx="3"/>
                        <line x1="-122" y1="30" x2="-122" y2="95" stroke="#0e3338" stroke-width="2"/>
                        <line x1="-150" y1="62" x2="-95" y2="62" stroke="#0e3338" stroke-width="2"/>

                        <rect x="95" y="30" width="55" height="65" fill="#eaf7f9" stroke="#0e3338" stroke-width="4" rx="3"/>
                        <line x1="122" y1="30" x2="122" y2="95" stroke="#0e3338" stroke-width="2"/>
                        <line x1="95" y1="62" x2="150" y2="62" stroke="#0e3338" stroke-width="2"/>

                        <!-- Main Front Door -->
                        <rect x="-30" y="60" width="60" height="110" fill="#1b636c" stroke="#0e3338" stroke-width="5" rx="3"/>
                        <circle cx="18" cy="115" r="5" fill="url(#silverGrad)"/>
                    </g>

                    <!-- Open Book Base & Pages -->
                    <g id="bookGroup" transform="translate(500, 560)" filter="url(#dropShadow)">
                        <!-- Book Leather Cover Backing -->
                        <path d="M-380,100 C-220,70 -80,120 0,140 C80,120 220,70 380,100 L360,130 C200,100 70,140 0,165 C-70,140 -200,100 -360,130 Z" fill="#0b2b30" stroke="#051619" stroke-width="4"/>
                        <path d="M-370,80 C-210,50 -70,100 0,125 C70,100 210,50 370,80 L370,110 C210,80 70,130 0,150 C-70,130 -210,80 -370,110 Z" fill="url(#silverGrad)"/>

                        <!-- Book Thick Page Stack Layers -->
                        <path d="M-360,70 C-200,40 -60,85 0,110 C60,85 200,40 360,70 L355,95 C200,68 60,110 0,135 C-60,110 -200,68 -355,95 Z" fill="#d9ceb9" stroke="#524835" stroke-width="2"/>

                        <!-- Main Open Pages Spread -->
                        <path d="M-350,60 C-190,25 -50,75 0,100 C50,75 190,25 350,60 L340,-120 C180,-150 50,-100 0,-70 C-50,-100 -180,-150 -340,-120 Z" fill="url(#paperGrad)" stroke="#423725" stroke-width="5"/>

                        <!-- Center Spine Binding Shadow -->
                        <path d="M-15,-78 C-5,-70 0,80 0,100 C0,80 5,-70 15,-78 Z" fill="#b09e7c" opacity="0.8"/>

                        <!-- Faint Text Lines Left Page -->
                        <g stroke="#8c7b60" stroke-width="3" stroke-linecap="round" opacity="0.6">
                            <line x1="-300" y1="-90" x2="-60" y2="-45"/>
                            <line x1="-295" y1="-70" x2="-60" y2="-28"/>
                            <line x1="-290" y1="-50" x2="-60" y2="-10"/>
                            <line x1="-285" y1="-30" x2="-60" y2="8"/>
                            <line x1="-280" y1="-10" x2="-60" y2="25"/>
                            <line x1="-275" y1="10" x2="-60" y2="42"/>
                            <line x1="-270" y1="30" x2="-60" y2="60"/>
                        </g>

                        <!-- Faint Text Lines Right Page -->
                        <g stroke="#8c7b60" stroke-width="3" stroke-linecap="round" opacity="0.6">
                            <line x1="60" y1="-45" x2="300" y2="-90"/>
                            <line x1="60" y1="-28" x2="295" y2="-70"/>
                            <line x1="60" y1="-10" x2="290" y2="-50"/>
                            <line x1="60" y1="8" x2="285" y2="-30"/>
                            <line x1="60" y1="25" x2="280" y2="-10"/>
                            <line x1="60" y1="42" x2="275" y2="10"/>
                            <line x1="60" y1="60" x2="270" y2="30"/>
                        </g>
                    </g>

                    <!-- Magic Branch & Accessories rising from Inkwell -->
                    <g id="magicGroup" transform="translate(500, 360)" style="display: block;">
                        <!-- Main Sprouting Olive/Quill Stem -->
                        <path d="M0,110 C-20,40 30,-20 90,-110 C120,-155 170,-190 230,-220" fill="none" stroke="#257c87" stroke-width="12" stroke-linecap="round"/>
                        <path d="M0,110 C-20,40 30,-20 90,-110 C120,-155 170,-190 230,-220" fill="none" stroke="url(#silverGrad)" stroke-width="5" stroke-linecap="round"/>

                        <!-- Leaves Branching Off Stem -->
                        <g fill="#43ab38" stroke="#09292f" stroke-width="3">
                            <path transform="translate(30,-10) rotate(-40)" d="M0,0 Q20,-30 40,-10 Q20,10 0,0 Z" fill="#58c48a"/>
                            <path transform="translate(60,-50) rotate(20)" d="M0,0 Q30,-25 50,0 Q25,25 0,0 Z" fill="#58c48a"/>
                            <path transform="translate(90,-90) rotate(-35)" d="M0,0 Q25,-30 45,-5 Q20,20 0,0 Z" fill="#58c48a"/>
                            <path transform="translate(130,-130) rotate(15)" d="M0,0 Q30,-20 50,5 Q20,25 0,0 Z" fill="#58c48a"/>
                            <path transform="translate(170,-170) rotate(-25)" d="M0,0 Q25,-25 45,0 Q20,20 0,0 Z" fill="#58c48a"/>
                        </g>

                        <!-- Floating Open Books near top branch -->
                        <g transform="translate(100, -180) rotate(-15) scale(0.9)" filter="url(#dropShadow)">
                            <path d="M-30,0 Q-15,-15 0,-3 Q15,-15 30,0 L25,35 Q15,20 0,25 Q-15,20 -25,35 Z" fill="#fffbf2" stroke="#09292f" stroke-width="3"/>
                            <path d="M-35,5 L-30,0 L25,35 L20,40 Z" fill="#257c87"/>
                        </g>
                        
                        <g transform="translate(140, -250) rotate(10) scale(0.7)" filter="url(#dropShadow)">
                            <path d="M-30,0 Q-15,-15 0,-3 Q15,-15 30,0 L25,35 Q15,20 0,25 Q-15,20 -25,35 Z" fill="#fffbf2" stroke="#09292f" stroke-width="3"/>
                        </g>

                        <!-- Magic Genie / Oil Lamp -->
                        <g transform="translate(200, -230) scale(1.1)" filter="url(#dropShadow)">
                            <!-- Lamp Body -->
                            <path d="M-20,10 C-40,10 -50,-10 -20,-20 C0,-25 30,-20 50,-5 C60,0 40,20 20,20 C0,20 -10,10 -20,10 Z" fill="url(#silverGrad)" stroke="#09292f" stroke-width="3"/>
                            <!-- Spout & Handle -->
                            <path d="M-40,-5 C-60,-15 -50,-35 -35,-30 C-25,-25 -30,-10 -20,-10" fill="none" stroke="url(#silverGrad)" stroke-width="4"/>
                            <path d="M50,-5 Q65,-10 70,-15 Q65,-3 55,2" fill="url(#silverGrad)" stroke="#09292f" stroke-width="2"/>
                            <!-- Base -->
                            <ellipse cx="0" cy="22" rx="18" ry="6" fill="url(#silverGrad)" stroke="#09292f" stroke-width="3"/>
                            <!-- Magic Smoke Wisp -->
                            <path d="M70,-15 Q80,-30 75,-40 T85,-60" fill="none" stroke="#e0f7fa" stroke-width="3" stroke-linecap="round" opacity="0.8"/>
                        </g>
                    </g>

                    <!-- Inkwell Pot & Fountain Pen -->
                    <g id="inkwellGroup" transform="translate(500, 520)" filter="url(#dropShadow)" style="display: block;">
                        <!-- Inkwell Jar Body -->
                        <path d="M-70,0 C-80,-40 -50,-90 0,-90 C50,-90 80,-40 70,0 C60,40 -60,40 -70,0 Z" fill="url(#inkwellGrad)" stroke="#09292f" stroke-width="6"/>
                        <!-- Inkwell Metallic Lip/Rim -->
                        <ellipse cx="0" cy="-90" rx="45" ry="15" fill="url(#silverGrad)" stroke="#09292f" stroke-width="5"/>
                        <ellipse cx="0" cy="-90" rx="30" ry="8" fill="#041f24"/>
                        <!-- Glass Highlight Reflection -->
                        <path d="M-45,-30 C-50,-60 -30,-75 -10,-80 C-20,-60 -35,-40 -35,-20 Z" fill="#ffffff" opacity="0.4"/>

                        <!-- Classic Nib Fountain Pen lying on right page -->
                        <g transform="translate(140, 20) rotate(-35)" filter="url(#dropShadow)">
                            <!-- Pen Shaft -->
                            <rect x="-12" y="-120" width="24" height="150" fill="#1b636c" stroke="#09292f" stroke-width="4" rx="4"/>
                            <rect x="-10" y="-115" width="6" height="140" fill="#ffffff" opacity="0.3" rx="2"/>
                            <!-- Metallic Band -->
                            <rect x="-13" y="10" width="26" height="15" fill="url(#silverGrad)" stroke="#09292f" stroke-width="3"/>
                            <!-- Pen Nib Tip -->
                            <path d="M-12,25 L0,65 L12,25 Z" fill="url(#silverGrad)" stroke="#09292f" stroke-width="3"/>
                            <line x1="0" y1="25" x2="0" y2="52" stroke="#09292f" stroke-width="2"/>
                            <circle cx="0" cy="42" r="2.5" fill="#09292f"/>
                        </g>
                    </g>

                    <!-- Main Text Banner & Sub-ribbon -->
                    <g id="bannerGroup" transform="translate(500, 770)" filter="url(#dropShadow)">
                        
                        <!-- Left Folded Ribbon Wing -->
                        <path d="M-380,20 L-280,-40 L-280,40 L-380,100 L-330,60 Z" fill="#0a2a30" stroke="#05171a" stroke-width="4"/>
                        <path d="M-380,20 L-280,-30 L-280,30 L-380,80 Z" fill="url(#bannerGrad)" stroke="url(#silverGrad)" stroke-width="4"/>

                        <!-- Right Folded Ribbon Wing -->
                        <path d="M380,20 L280,-40 L280,40 L380,100 L330,60 Z" fill="#0a2a30" stroke="#05171a" stroke-width="4"/>
                        <path d="M380,20 L280,-30 L280,30 L380,80 Z" fill="url(#bannerGrad)" stroke="url(#silverGrad)" stroke-width="4"/>

                        <!-- Main Central Curved Banner Plate -->
                        <path d="M-310,-45 C-180,-75 180,-75 310,-45 C330,15 330,45 310,75 C180,45 -180,45 -310,75 C-330,45 -330,15 -310,-45 Z" fill="url(#bannerGrad)" stroke="url(#silverGrad)" stroke-width="7"/>
                        
                        <path d="M-295,-32 C-170,-60 170,-60 295,-32" fill="none" stroke="url(#silverGrad)" stroke-width="2"/>
                        <path d="M-295,60 C-170,32 170,32 295,60" fill="none" stroke="url(#silverGrad)" stroke-width="2"/>

                        <!-- Main Banner Text Header -->
                        <text id="svgMainText" x="0" y="12" text-anchor="middle" fill="url(#silverGrad)" stroke="#061e22" stroke-width="2" font-family="'Cinzel', 'Playfair Display', serif" font-weight="900" font-size="44" letter-spacing="4">HOMESCHOOLING</text>

                        <!-- Sub-ribbon Plaque underneath -->
                        <g transform="translate(0, 85)">
                            <rect x="-180" y="-22" width="360" height="44" fill="#09292f" stroke="url(#silverGrad)" stroke-width="3" rx="8"/>
                            <text id="svgSubText" x="0" y="7" text-anchor="middle" fill="#d1e3e7" font-family="'Inter', sans-serif" font-weight="700" font-size="22" letter-spacing="5">WITH NECESSITY</text>
                        </g>

                        <!-- Bottom Decorative Filigree Swirls beneath emblem -->
                        <g stroke="url(#silverGrad)" fill="none" stroke-width="4" stroke-linecap="round" transform="translate(0, 135)">
                            <path d="M-120,0 Q-60,25 0,0 Q60,25 120,0"/>
                            <path d="M-80,-10 C-40,15 -20,-15 0,5 C20,-15 40,15 80,-10"/>
                            <circle cx="0" cy="5" r="4" fill="url(#silverGrad)"/>
                        </g>
                    </g>
                </svg>