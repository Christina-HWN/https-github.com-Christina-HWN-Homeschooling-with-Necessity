    <script>
        function updateTracker() {
            const core = parseInt(document.getElementById('core-slider').value);
            const home = parseInt(document.getElementById('home-slider').value);
            const elective = parseInt(document.getElementById('elective-slider').value);

            let effectiveHome = Math.min(home, core);

            document.getElementById('core-val').innerText = core + ' hrs';
            document.getElementById('home-val').innerText = effectiveHome + ' hrs';
            document.getElementById('elective-val').innerText = elective + ' hrs';

            const total = core + elective;
            document.getElementById('total-val').innerText = total + ' / 1000';

            const corePct = Math.min(100, (core / 1000) * 100);
            const electivePct = Math.min(100, (elective / 1000) * 100);

            document.getElementById('bar-core').style.width = corePct + '%';
            document.getElementById('bar-elective').style.width = electivePct + '%';

            const badge = document.getElementById('compliance-badge');
            
            if (total >= 1000 && core >= 600 && effectiveHome >= 400) {
                badge.className = "py-2 px-4 rounded-xl font-bold text-xs bg-brand-500/20 text-brand-100 border border-brand-500/30";
                badge.innerHTML = "<i class='fa-solid fa-circle-check text-brand-500 mr-1.5'></i> <strong>FULLY COMPLIANT:</strong> Satisfies all Missouri RSMo § 167.012 targets!";
            } else {
                let deficits = [];
                if (core < 600) deficits.push((600 - core) + " core hrs");
                if (effectiveHome < 400) deficits.push((400 - effectiveHome) + " home core hrs");
                if (total < 1000) deficits.push((1000 - total) + " total hrs");

                badge.className = "py-2 px-4 rounded-xl font-bold text-xs bg-accent-500/20 text-accent-300 border border-accent-500/30";
                badge.innerHTML = "<i class='fa-solid fa-triangle-exclamation text-accent-400 mr-1.5'></i> <strong>IN PROGRESS:</strong> Needs: " + deficits.join(", ") + ".";
            }
        }

        window.onload = function() {
            updateTracker();
        };
